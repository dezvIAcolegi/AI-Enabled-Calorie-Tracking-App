# Free key from https://aistudio.google.com (a Gemini app subscription does not include API access)
GEMINI_API_KEY=
# Optional, default gemini-3.5-flash-lite
# GEMINI_MODEL=
# Used to verify the caller's Supabase access token
SUPABASE_URL=
# Supabase publishable (anon) key, for foods search under the caller's token (RLS applies)
SUPABASE_ANON_KEY=
