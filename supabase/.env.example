# Copy to supabase/.env.dev (your dev project) and supabase/.env.shared (the team project).
# Both copies are git-ignored. Scripts read one with: deno run --env-file=supabase/.env.dev ...
# Values: Supabase dashboard → Project Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Never put it in the app, a commit or a chat.
SUPABASE_SERVICE_ROLE_KEY=
# Database password chosen when the project was created; the CLI reads it for `link` and `db push`.
SUPABASE_DB_PASSWORD=
